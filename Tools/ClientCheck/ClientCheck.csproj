<Project Sdk="Microsoft.NET.Sdk">
  <!-- Compile-only check of the Unity client scripts against UnityEngine reference assemblies.
       This does NOT replace compiling inside the Unity editor; it catches C# and API mistakes early. -->
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0649;CS0414;CS0169</NoWarn>
    <DefineConstants>$(DefineConstants);UNITY_STANDALONE;UNITY_STANDALONE_WIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Project/Scripts/Simulation/**/*.cs" />
    <Compile Include="../../Assets/_Project/Scripts/Client/**/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="UnityEngine.Modules" Version="2021.3.33" />
  </ItemGroup>
</Project>
