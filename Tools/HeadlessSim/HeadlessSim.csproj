<Project Sdk="Microsoft.NET.Sdk">
  <!-- Headless simulation harness: compiles the engine-independent RTS.Simulation sources and runs
       AI-vs-AI matches and campaign mission smoke runs without the Unity editor. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <NoWarn>CS0649;CS0414;CS0169</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../Assets/_Project/Scripts/Simulation/**/*.cs" />
  </ItemGroup>
</Project>
